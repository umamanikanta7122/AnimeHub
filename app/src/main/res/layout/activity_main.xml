<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="One Piece\nLuffy - Gear 5\nZoro - King of Hell\nSanji - Ifrit Jambe"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:padding="12dp"
            android:background="#1E1E1E"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Naruto\nNaruto - Rasengan\nSasuke - Sharingan\nItachi - Tsukuyomi"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:padding="12dp"
            android:background="#1E1E1E"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bleach\nIchigo - Bankai\nAizen - Kyoka Suigetsu\nByakuya - Senbonzakura"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:padding="12dp"
            android:background="#1E1E1E"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Attack on Titan\nEren - Attack Titan\nLevi - Ackerman Skills\nMikasa - Elite Combat"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:padding="12dp"
            android:background="#1E1E1E"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Demon Slayer\nTanjiro - Water Breathing\nZenitsu - Thunder Breathing\nNezuko - Blood Demon Art"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:padding="12dp"
            android:background="#1E1E1E"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Jujutsu Kaisen\nGojo - Limitless\nSukuna - Malevolent Shrine\nYuji - Black Flash"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:padding="12dp"
            android:background="#1E1E1E"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Death Note\nLight - Death Note\nL - Deduction Skills\nRyuk - Shinigami Powers"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:padding="12dp"
            android:background="#1E1E1E"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Solo Leveling\nSung Jinwoo - Shadow Monarch\nIgris - Shadow Knight\nBeru - Ant King"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:padding="12dp"
            android:background="#1E1E1E"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/startBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Explore Anime" />

        <Button
            android:id="@+id/logoutBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Logout" />

    </LinearLayout>

</ScrollView>